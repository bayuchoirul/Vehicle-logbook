{
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/logs", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/js/config/env.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
