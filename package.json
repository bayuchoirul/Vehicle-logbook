{
  "name": "vehicle-logbook",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Modular Vehicle Fuel & Maintenance Logbook PWA powered by Supabase and Tailwind CSS",
  "scripts": {
    "build:config": "node scripts/build-config.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build": "npm run build:config && npm run build:css",
    "dev:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
