{
  "name": "vehicle-logbook",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:config": "node scripts/build-config.js",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./css/output.css --minify",
    "build": "npm run build:config && npm run build:css",
    "dev:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./css/output.css --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}